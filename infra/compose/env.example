# Copy to infra/compose/.env (gitignored) to override stack settings. Never put secrets here:
# secrets live in .secrets/ (make secrets) and are mounted as files.

# Remote access over Tailscale (D17): `tailscale serve --bg --https=443 http://127.0.0.1:8080`
# TB_AUTH_RP_ID=mini.example-tailnet.ts.net
# TB_AUTH_ORIGINS=https://mini.example-tailnet.ts.net,http://localhost:8080
# The proxy's source address as seen by the gateway (docker network inspect strawberry_edge → Gateway).
# TB_TRUSTED_PROXIES=192.168.5.0/24

# Optional public URL through Cloudflare Tunnel + Access (profile remote-cloudflare); add its hostname:
# TB_AUTH_ORIGINS=https://trade.example.com,https://mini.example-tailnet.ts.net,http://localhost:8080

# Host ports (always bound to 127.0.0.1)
# TB_HTTP_PORT=8080
# TB_GRAFANA_PORT=3000

# Logging and environment label shown in the UI banner
# TB_ENVIRONMENT=local
# TB_LOG_LEVEL=info

# Containerd socket for cAdvisor (Colima and systemd Docker use the default)
# TB_CONTAINERD_SOCK=/run/containerd/containerd.sock

# Brokers (section 04). Alpaca credentials are entered in the UI (Broker connections) and stored
# encrypted; only account names and environments live here.
# TB_ALPACA_ACCOUNTS=alpaca-paper:paper            # add ",alpaca-live:live" for the live account
# TB_ALPACA_DATA_ACCOUNT=alpaca-paper              # whose key holds the single market-data socket
# TB_ALPACA_DATA_FEEDS=alpaca.sip,alpaca.iex       # alpaca.sip needs Algo Trader Plus (O2)
# TB_ALPACA_DATA_RATE_PER_MIN=8000                 # 160 on the free Basic plan (BR-016)
# TB_SIM_ACCOUNTS=sim-paper                        # empty disables the simulator account
# TB_TRADING_LIVE_ENABLED=false                    # BR-013: also needs an audited per-account enablement

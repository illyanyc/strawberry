    },
    {
      "type": "logs",
      "title": "Error and warning logs (VictoriaLogs)",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "level:in(error, warn, ERROR, WARNING)",
          "queryType": "instant",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 15
    }
  ],
  "description": "Every service's health, resources, HTTP traffic, bus lag, DB connections, clock skew, disk, backups, and recent error logs (OP-060)."
}

{
  "name": "@strawberry/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Generated TypeScript types for contracts/proto (protoc-gen-es). Do not edit src/ by hand; run `make gen`.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "typescript": "7.0.2"
  }
}
